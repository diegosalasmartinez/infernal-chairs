# NOTE: *.rbxl/*.rbxlx are VERSIONED (not ignored) — the lobby decor lives in
# the .rbxl directly because Rojo can't roundtrip Marketplace assets with PBR /
# MaterialVariantSerialized / binary mesh properties. See ROBLOX_PLAYBOOK.md
# section 3 (Rojo quirks) for the full story.

# Studio lock files
*.rbxl.lock
*.rbxlx.lock

# Ignore .rbxm/.rbxmx everywhere (build artifacts, Studio backups, stray exports).
# We no longer use $path to .rbxm for Marketplace assets — Rojo can't roundtrip
# their PBR/MaterialVariant/binary mesh properties cleanly. All such assets live
# inside the .rbxl directly (Workspace.Lobby.Decor + ReplicatedStorage.Templates).
*.rbxm
*.rbxmx

# Rojo build artifacts
sourcemap.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE local state
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Local environment overrides
.env
.env.local
