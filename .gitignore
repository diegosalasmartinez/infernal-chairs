# Roblox place files (build output of `rojo build`)
*.rbxl
*.rbxlx

# Studio lock files
*.rbxl.lock
*.rbxlx.lock

# Ignore .rbxm/.rbxmx everywhere by default (build artifacts, Studio backups,
# stray exports), but KEEP the source assets in assets/ — those are bundled
# Marketplace models referenced by default.project.json via $path. Without
# them the repo can't build on another machine.
*.rbxm
*.rbxmx
!assets/*.rbxm
!assets/*.rbxmx

# Rojo build artifacts
sourcemap.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE local state
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Local environment overrides
.env
.env.local
